{
  "compilerOptions": {
    "strict": true,
    "module": "nodenext",
    "lib": ["ESNext", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,

    // Bun brings along a bunch of types that I don't want to be visible from
    // any game logic (e.g. react). To "hide" these we're just resetting the
    // types and then including them on a need to use basis through
    // tripleslash <reference> comments.
    //
    // A more complicated composite setup with multiple tsconfig projects would
    // be possible, but way more complicated than is necessary right now.
    "types": ["@types/bun"]
  }
}
